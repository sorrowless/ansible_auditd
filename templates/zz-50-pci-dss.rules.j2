##
## PCI DSS 4.0 requirement 10 — local auditd coverage
## Managed by sorrowless.auditd — do not edit by hand
##

## 10.2.1.3 / 10.2.1.6 — audit trail access and audit system changes
-w /var/log/audit/ -p wa -k pci-audit-log
-w /etc/audit/ -p wa -k pci-audit-config
-w /etc/libaudit.conf -p wa -k pci-audit-config
-w /etc/audisp/ -p wa -k pci-audit-config
-w /lib/systemd/system/auditd.service -p wa -k pci-audit-config
-w /usr/sbin/auditctl -p x -k pci-audit-tools
-w /usr/sbin/auditd -p x -k pci-audit-tools
-w /usr/sbin/augenrules -p x -k pci-audit-tools

## 10.2.1.4 — failed access attempts
-a always,exit -F arch=b64 -S open,openat,openat2,creat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=4294967295 -k pci-access
-a always,exit -F arch=b64 -S open,openat,openat2,creat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=4294967295 -k pci-access
{% if ansible_architecture == 'x86_64' %}
-a always,exit -F arch=b32 -S open,openat,openat2,creat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=4294967295 -k pci-access
-a always,exit -F arch=b32 -S open,openat,openat2,creat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=4294967295 -k pci-access
{% endif %}

## 10.2.1.5 — identification and authentication
-w /etc/pam.d/ -p wa -k pci-identity
-w /etc/security/ -p wa -k pci-identity
-w /var/log/faillog -p wa -k pci-identity
-w /var/log/lastlog -p wa -k pci-identity
-w /var/log/tallylog -p wa -k pci-identity
-w /var/run/faillock/ -p wa -k pci-identity
-w /var/log/wtmp -p wa -k pci-session
-w /var/log/btmp -p wa -k pci-session
-w /var/run/utmp -p wa -k pci-session

## 10.2.1.2 — actions taken by individuals with administrative privileges
{% for bin in auditd_pci_privileged_bins | default([]) %}
-a always,exit -F path={{ bin }} -F perm=x -F auid>=1000 -F auid!=4294967295 -k pci-admin
{% endfor %}

## 10.2.1.7 — creation and deletion of system-level objects
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=4294967295 -k pci-delete
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat,chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=4294967295 -k pci-perm-mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=4294967295 -k pci-perm-mod
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=4294967295 -k pci-mount
{% if ansible_architecture == 'x86_64' %}
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=4294967295 -k pci-delete
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat,chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=4294967295 -k pci-perm-mod
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=4294967295 -k pci-perm-mod
-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=4294967295 -k pci-mount
{% endif %}

{% if auditd_pci_data_paths | length > 0 %}
## 10.2.1.1 — access to cardholder data paths
{% for path in auditd_pci_data_paths %}
-w {{ path }} -p rwxa -k pci-cardholder
{% endfor %}
{% endif %}
